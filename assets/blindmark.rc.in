#pragma code_page(65001)
#include <winresrc.h>

1 ICON "@ICON@"
1 24 "@MANIFEST@"

301 BITMAP "@WM_BMP@"
302 BITMAP "@HD_BMP@"

/* Wizard97 pages, sized per the MSDN "Creating Wizards" guidance:
     200             exterior (welcome): 317x193 dialog units, left 164 px reserved
                     for the watermark, PSP_HIDEHEADER set in code
     201..206        interior: 317x143, the header band is drawn by the sheet
   The dialogs stay empty; src/win/wizard.rs builds the controls at run time so they
   share the DPI and font handling of the tabbed window. */
200 DIALOGEX 0, 0, 317, 193
STYLE DS_SETFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "BlindMark 向导"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END

201 DIALOGEX 0, 0, 317, 193
STYLE DS_SETFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "BlindMark 向导"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END

202 DIALOGEX 0, 0, 317, 193
STYLE DS_SETFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "BlindMark 向导"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END

203 DIALOGEX 0, 0, 317, 193
STYLE DS_SETFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "BlindMark 向导"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END

204 DIALOGEX 0, 0, 317, 193
STYLE DS_SETFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "BlindMark 向导"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END

205 DIALOGEX 0, 0, 317, 193
STYLE DS_SETFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "BlindMark 向导"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END

206 DIALOGEX 0, 0, 317, 193
STYLE DS_SETFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "BlindMark 向导"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END

1 VERSIONINFO
FILEVERSION @VER_COMMA@
PRODUCTVERSION @VER_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "blindmark 盲水印"
            VALUE "FileVersion", "@VER@"
            VALUE "InternalName", "blindmark"
            VALUE "LegalCopyright", "© 2026 Lupo · MIT OR Apache-2.0"
            VALUE "OriginalFilename", "blindmark.exe"
            VALUE "ProductName", "blindmark"
            VALUE "ProductVersion", "@VER@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
