#pragma code_page(65001)
#include <winresrc.h>

1 ICON "@ICON@"
1 24 "@MANIFEST@"

1 VERSIONINFO
FILEVERSION @VER_COMMA@
PRODUCTVERSION @VER_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "blindmark 盲水印"
            VALUE "FileVersion", "@VER@"
            VALUE "InternalName", "blindmark"
            VALUE "LegalCopyright", "© 2026 Lupo · MIT OR Apache-2.0"
            VALUE "OriginalFilename", "blindmark.exe"
            VALUE "ProductName", "blindmark"
            VALUE "ProductVersion", "@VER@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
